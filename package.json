{
  "name": "ogasys-web-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Hono + Tailwind CSS v3 + Cloudflare Workers の OgaTomo Systems Webアプリテンプレート",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "wrangler dev --local --ip 127.0.0.1",
    "build:css": "tailwindcss -i src/styles.css -o public/assets/app.css --minify",
    "build": "wrangler deploy --dry-run --outdir dist",
    "check": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/tests/*.test.js",
    "test:ui": "node --test tests/ui.test.mjs",
    "release:check": "npm run check && npm test && npm run build",
    "deploy": "npm run release:check && npm run test:ui && wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "playwright": "^1.63.0",
    "tailwindcss": "~3.4.0",
    "typescript": "~5.9.0",
    "wrangler": "^4.0.0"
  }
}
